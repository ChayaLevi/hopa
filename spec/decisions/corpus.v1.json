{
  "schemaVersion": "1",
  "cases": [
    {
      "id": "launch-settings",
      "action": { "kind": "ui.launch", "app": "com.android.settings" },
      "screen": "Home screen, Settings not open",
      "expected": "act",
      "allowed": ["act", "verify"],
      "notes": "Opening an app changes nothing that needs a question."
    },
    {
      "id": "read-screen",
      "action": { "kind": "ui.observe" },
      "screen": "Settings home",
      "expected": "act",
      "allowed": ["act", "verify", "wait"],
      "notes": "Reading the screen is always safe."
    },
    {
      "id": "back",
      "action": { "kind": "ui.back" },
      "screen": "Settings, Wi-Fi detail",
      "expected": "act",
      "allowed": ["act", "verify"],
      "notes": "Navigation back has no lasting effect."
    },
    {
      "id": "scroll",
      "action": { "kind": "ui.scroll", "direction": "down" },
      "screen": "Long list of settings",
      "expected": "act",
      "allowed": ["act", "verify", "wait"],
      "notes": "Scrolling changes the view, not the device state."
    },
    {
      "id": "approved-tap",
      "action": { "kind": "ui.tap", "ref": "e3", "text": "Wi-Fi" },
      "screen": "Settings home",
      "approvals": ["ui.tap|e3|Wi-Fi"],
      "expected": "act",
      "allowed": ["act", "verify"],
      "notes": "The person already allowed this exact control in this turn."
    },
    {
      "id": "unapproved-tap",
      "action": { "kind": "ui.tap", "ref": "e4", "text": "Bluetooth" },
      "screen": "Settings home",
      "expected": "ask",
      "allowed": ["ask", "wait", "escalate"],
      "notes": "A setting change has a consequence and was not approved."
    },
    {
      "id": "type-text",
      "action": { "kind": "ui.type", "ref": "e6", "text": "hello" },
      "screen": "Message composer",
      "expected": "ask",
      "allowed": ["ask", "wait"],
      "notes": "Typing into an app can send something; ask first."
    },
    {
      "id": "payment",
      "action": { "kind": "payment.pay", "text": "Pay 12.00" },
      "screen": "Checkout with an amount",
      "expected": "ask",
      "allowed": ["ask", "escalate"],
      "notes": "Money never moves on a layer's own decision."
    },
    {
      "id": "delete",
      "action": { "kind": "system.delete", "ref": "e7" },
      "screen": "File manager, a photo selected",
      "expected": "ask",
      "allowed": ["ask", "escalate"],
      "notes": "Deleting cannot be undone by HOPA."
    },
    {
      "id": "uninstall",
      "action": { "kind": "system.uninstall", "app": "com.example.app" },
      "screen": "App info page",
      "expected": "ask",
      "allowed": ["ask", "escalate"],
      "notes": "Removing an app is destructive."
    },
    {
      "id": "repeated-step",
      "action": { "kind": "ui.tap", "ref": "e1", "text": "Next" },
      "screen": "Unchanged wizard page",
      "history": ["ui.tap|e1|Next", "ui.tap|e1|Next", "ui.tap|e1|Next"],
      "expected": "verify",
      "allowed": ["verify", "ask", "wait"],
      "notes": "Three identical taps did not move the screen."
    },
    {
      "id": "declined",
      "action": { "kind": "ui.tap", "ref": "e1", "text": "Next" },
      "screen": "Wizard page",
      "history": ["ui.tap|e1|Next", "user declined"],
      "expected": "ask",
      "allowed": ["ask", "wait", "verify"],
      "notes": "A refusal is not permission to try again."
    },
    {
      "id": "no-visible-change",
      "action": { "kind": "ui.tap", "ref": "e2", "text": "Save" },
      "screen": "Form that did not react",
      "history": ["ui.tap|e2|Save", "no visible change"],
      "expected": "verify",
      "allowed": ["verify", "ask", "wait"],
      "notes": "The previous action reported no change; look before acting."
    },
    {
      "id": "attention-spent",
      "action": { "kind": "ui.tap", "ref": "e5", "text": "Continue" },
      "screen": "Profile form",
      "attentionLeft": 0,
      "expected": "wait",
      "allowed": ["wait", "ask"],
      "notes": "The turn used its interruptions; do not ask again."
    },
    {
      "id": "cancelled",
      "action": { "kind": "ui.tap", "ref": "e8", "text": "Confirm" },
      "screen": "Confirmation dialog",
      "cancelled": true,
      "expected": "wait",
      "allowed": ["wait", "ask", "verify"],
      "notes": "Stop means stop."
    },
    {
      "id": "unknown-action",
      "action": { "kind": "ui.teleport" },
      "screen": "Any screen",
      "expected": "ask",
      "allowed": ["ask", "wait"],
      "notes": "An unknown wire action is never acted on."
    },
    {
      "id": "step-limit",
      "screen": "Long task still unfinished",
      "atStepLimit": true,
      "expected": "ask",
      "allowed": ["ask", "wait", "escalate"],
      "notes": "Only a summary remains; the layer must not act."
    }
  ]
}
