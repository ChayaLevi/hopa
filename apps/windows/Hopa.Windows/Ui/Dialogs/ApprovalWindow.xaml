<Window x:Class="Hopa.Windows.Ui.Dialogs.ApprovalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Approval"
        Icon="pack://application:,,,/Hopa.Windows;component/Assets/hopa.ico"
        Width="520" MinHeight="240" MaxHeight="640"
        SizeToContent="Height"
        Background="#F7F4EE"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!-- Drawn from an A2UI approval card (ADR-0031); CardView fills the body. -->
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <Border x:Name="PaymentBadge" Visibility="Collapsed" Background="#FBE6E4" CornerRadius="6"
                    HorizontalAlignment="Left" Padding="8,2" Margin="0,0,0,8">
                <TextBlock Text="PAYMENT" FontSize="10" FontWeight="SemiBold" Foreground="#B3261E" />
            </Border>
            <TextBlock x:Name="TitleLabel" FontSize="15" FontWeight="SemiBold" Foreground="#1C1B18"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="BodyPanel" />
        </ScrollViewer>

        <CheckBox x:Name="AcknowledgeBox" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0"
                  Foreground="#1C1B18" Checked="Acknowledge_Changed" Unchecked="Acknowledge_Changed" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="DenyButton" Width="96" Height="34" Margin="0,0,8,0" Click="Deny_Click" />
            <Button x:Name="AllowButton" Width="96" Height="34"
                    Background="#0A59F7" Foreground="#FFFFFF" BorderThickness="0"
                    Click="Allow_Click" />
        </StackPanel>
    </Grid>
</Window>
